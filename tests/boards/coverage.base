# Regenerated by hand: what has a test and what does not.
filters:
  and:
    - 'note.type != "test"'
    - 'note.status_category != "done"'
properties:
  note.key:
    displayName: Key
  note.title:
    displayName: Title
  note.tested_by:
    displayName: Tested by
views:
  - type: table
    name: Coverage
    order:
      - note.key
      - note.title
      - note.tested_by
